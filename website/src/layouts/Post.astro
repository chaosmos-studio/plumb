---
import { Image, getImage } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Giscus from "../components/Giscus.astro";
import Person from "../components/Person.astro";
import PostCard from "../components/PostCard.astro";
import StoreButtons from "../components/StoreButtons.astro";
import Toc from "../components/Toc.astro";
import Video from "../components/Video.astro";
import { authors, site } from "../site.config";
import { article, breadcrumbs, video } from "../utils/schema";
import { absoluteFromRoot, href } from "../utils/url";

interface Props {
  post: CollectionEntry<"blog">;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const d = post.data;
const path = `blog/${post.id}/`;
const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const date = d.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

// Google asks for article images in 16:9, 4:3 and 1:1; the cover supplies all three.
const crops = await Promise.all(
  [
    [1200, 675],
    [1200, 900],
    [1200, 1200],
  ].map(([width, height]) => getImage({ src: d.cover, width, height, fit: "cover", format: "jpg" }))
);
const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: "cover", format: "jpg" });

const all = await getCollection("blog");
const related = all
  .filter(p => p.id !== post.id && p.data.tags.some(t => d.tags.includes(t)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const schema = [
  article({
    title: d.title,
    description: d.description,
    path,
    images: crops.map(c => absoluteFromRoot(c.src)),
    published: d.pubDate,
    modified: d.updatedDate,
    authorIds: d.authors,
    tags: d.tags,
    words,
  }),
  breadcrumbs([
    { label: "Blog", path: "blog/" },
    { label: d.title, path },
  ]),
  ...(d.video ? [video(d.video)!] : []),
];
---

<Base
  title={d.title}
  description={d.description}
  path={path}
  type="article"
  image={absoluteFromRoot(og.src)}
  imageAlt={d.coverAlt}
  published={d.pubDate}
  modified={d.updatedDate}
  authors={d.authors.map(id => authors[id].name)}
  tags={d.tags}
  schema={schema}
>
  <article class="post" data-pagefind-body>
    <header class="narrow head">
      <Crumbs trail={[{ label: "Blog", path: "blog/" }, { label: d.title }]} />
      <div class="tags">
        {d.tags.map(t => <a class="chip" href={href(`blog/tags/${t.toLowerCase().replace(/\s+/g, "-")}/`)}>{t}</a>)}
      </div>
      <h1 data-pagefind-meta="title">{d.title}</h1>
      <p class="lede">{d.description}</p>
      <p class="meta">
        <time datetime={d.pubDate.toISOString()}>{date}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        <span aria-hidden="true">·</span>
        <span>By {d.authors.map(id => authors[id].name).join(" and ")}</span>
      </p>
    </header>

    <div class="wrap cover-wrap">
      <Image
        src={d.cover}
        alt={d.coverAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1120px) 1120px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="cover"
        data-pagefind-meta="image[src], image_alt[alt]"
      />
    </div>

    <div class="narrow">
      {d.video && <Video id={d.video} />}
      <Toc headings={headings} />
      <div class="prose">
        <slot />
      </div>

      <aside class="cta card" data-pagefind-ignore>
        <div>
          <p class="eyebrow">Play {site.name}</p>
          <p class="cta-line">{site.tagline}. Free, offline, no ads.</p>
        </div>
        <StoreButtons />
      </aside>

      <section class="byline" data-pagefind-ignore>
        <p class="eyebrow">Written by</p>
        <div class="grid">
          {d.authors.map(id => <Person person={authors[id]} compact />)}
        </div>
      </section>
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap related" data-pagefind-ignore>
      <h2>Keep reading</h2>
      <div class="grid grid-3">
        {related.map(p => <PostCard post={p} />)}
      </div>
    </section>
  )}

  <section class="narrow comments" data-pagefind-ignore>
    <h2>Comments</h2>
    <p class="muted">Sign in with GitHub to leave a comment or a question.</p>
    <Giscus />
  </section>
</Base>

<style>
  .head {
    padding-top: 2.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--soft);
    font-size: 0.95rem;
  }
  .cover-wrap {
    margin: 2rem auto 2.5rem;
  }
  .cover {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .cta {
    margin: 3rem 0 2rem;
    padding: 1.4rem 1.6rem;
    display: grid;
    gap: 1rem;
  }
  .cta .eyebrow {
    margin: 0;
  }
  .cta-line {
    font-size: 1.2rem;
    margin: 0.2rem 0 0;
  }
  .byline .grid {
    margin-top: 0.4rem;
  }
  .related {
    margin-top: 4rem;
  }
  .comments {
    margin-top: 4rem;
  }
  .muted {
    color: var(--muted);
  }
</style>
