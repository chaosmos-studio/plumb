---
import { videos } from "../site.config";
import { href } from "../utils/url";
interface Props {
  id: string;
}
const v = videos.find(x => x.id === Astro.props.id);
if (!v) throw new Error(`unknown video ${Astro.props.id}`);
---
<figure class="video-block">
  <div class="video-frame">
    <video controls preload="none" playsinline poster={href(v.poster)} width={v.width} height={v.height} aria-label={v.title}>
      <source src={href(v.src)} type="video/mp4" />
    </video>
  </div>
  <figcaption>{v.description}</figcaption>
</figure>
<style>
  .video-block {
    margin: 2rem 0;
  }
  figcaption {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.92rem;
    text-align: center;
  }
</style>
