---
import { href } from "../utils/url";
interface Props {
  trail: { label: string; path?: string }[];
}
const { trail } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
  <a href={href("")}>Home</a>
  {trail.map(t => (
    <>
      <span aria-hidden="true">/</span>
      {t.path !== undefined ? <a href={href(t.path)}>{t.label}</a> : <span aria-current="page">{t.label}</span>}
    </>
  ))}
</nav>
<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--soft);
    margin-bottom: 1.5rem;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
</style>
