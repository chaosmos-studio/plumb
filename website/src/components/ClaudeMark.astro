---
// A neutral mark for the AI member of the team: a burst of eight rays in the site's accent. It is not
// Anthropic's logo, which belongs to Anthropic.
interface Props {
  size?: number;
}
const { size = 96 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 96 96" role="img" aria-label="Claude">
  <rect width="96" height="96" rx="48" fill="var(--surface-2)" />
  <g stroke="var(--accent)" stroke-width="6" stroke-linecap="round">
    {[0, 45, 90, 135].map(a => (
      <line x1="48" y1="24" x2="48" y2="72" transform={`rotate(${a} 48 48)`} />
    ))}
  </g>
  <circle cx="48" cy="48" r="7" fill="var(--surface-2)" />
</svg>
