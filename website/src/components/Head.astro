---
import { site } from "../site.config";
import { beaconToken } from "../utils/analytics";
import { absolute, href } from "../utils/url";

interface Props {
  title: string;
  description: string;
  /** The page's path inside the site, like "blog/how-to-play/"; "" is the home page. */
  path: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  published?: Date;
  modified?: Date;
  authors?: string[];
  tags?: string[];
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  image,
  imageAlt,
  type = "website",
  published,
  modified,
  authors = [],
  tags = [],
  noindex = false,
  schema = [],
} = Astro.props;

// The game's name belongs in every title once; a post whose title already names it needs no suffix.
const pageTitle = path === "" ? `${site.name}: ${site.tagline}` : title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = absolute(path);
const ogImage = image ?? absolute(`og/${path === "" ? "index" : path.replace(/\/$/, "")}.png`);
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Every page tells search engines what site it belongs to and who publishes it.
const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: absolute(""),
    description: site.description,
    inLanguage: "en",
    publisher: { "@type": "Person", name: "Shravan Goswami", url: "https://shravangoswami.com/" },
    potentialAction: {
      "@type": "SearchAction",
      target: `${absolute("")}?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
const allSchema = [...baseSchema, ...schema];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content={site.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={site.themeColor.dark} media="(prefers-color-scheme: dark)" />
<meta name="application-name" content={site.name} />
<meta name="generator" content={Astro.generator} />
{site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
{authors.map(a => <meta name="author" content={a} />)}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? `${site.name}: ${title}`} />
{type === "article" && published && <meta property="article:published_time" content={published.toISOString()} />}
{type === "article" && <meta property="article:modified_time" content={(modified ?? published ?? new Date()).toISOString()} />}
{type === "article" && tags.map(t => <meta property="article:tag" content={t} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? `${site.name}: ${title}`} />

<link rel="icon" href={href("favicon.ico")} sizes="48x48" />
<link rel="apple-touch-icon" href={href("apple-touch-icon.png")} />
<link rel="manifest" href={href("manifest.webmanifest")} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href={href("rss.xml")} />
<link rel="sitemap" href={href("sitemap-index.xml")} />

{allSchema.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
{beaconToken && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beaconToken })} />
)}
