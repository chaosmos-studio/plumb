---
import Icon from "./Icon.astro";
import { site, sponsorship } from "../site.config";
interface Props {
  /** One line and a button, to close a post, instead of the full card. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
{compact ? (
  <div class="sponsor-line" data-pagefind-ignore>
    <p><Icon name="heart" size={18} /> {sponsorship.line}</p>
    <a class="btn btn-quiet" href={site.sponsor} rel="noopener">Sponsor on GitHub</a>
  </div>
) : (
  <aside class="sponsor card" data-pagefind-ignore>
    <span class="mark" aria-hidden="true"><Icon name="heart" size={26} /></span>
    <div class="copy">
      <p class="eyebrow">Sponsor</p>
      <h2>{sponsorship.title[0]}<span class="accent">{sponsorship.title[1]}</span></h2>
      <p class="text">{sponsorship.lede}</p>
    </div>
    <a class="btn btn-quiet" href={site.sponsor} rel="noopener"><Icon name="heart" /> Sponsor on GitHub</a>
  </aside>
)}
<style>
  .sponsor {
    display: grid;
    gap: 1.2rem 2rem;
    align-items: center;
    justify-items: start;
    padding: clamp(1.5rem, 4vw, 2.4rem);
    background: linear-gradient(135deg, var(--surface), var(--surface-2));
  }
  @media (min-width: 760px) {
    .sponsor {
      grid-template-columns: auto 1fr auto;
    }
  }
  .mark {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .copy .eyebrow {
    margin-bottom: 0.4rem;
  }
  .copy h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .text {
    color: var(--muted);
    margin: 0;
    max-width: 38rem;
  }
  .sponsor :global(svg),
  .sponsor-line :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .sponsor-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .sponsor-line p {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: var(--muted);
  }
  .sponsor-line .btn {
    min-height: 44px;
    padding: 0 1.1rem;
  }
</style>
