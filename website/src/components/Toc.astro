---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const items = Astro.props.headings.filter(h => h.depth === 2);
// Headings keep their own words, numbers included, so the list is never numbered itself.
---
{items.length > 2 && (
  <nav class="toc card" aria-label="On this page" data-pagefind-ignore>
    <p class="eyebrow">On this page</p>
    <ul>
      {items.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ul>
  </nav>
)}
<style>
  .toc {
    padding: 1.1rem 1.4rem;
    margin: 0 0 2rem;
  }
  .toc .eyebrow {
    margin-bottom: 0.4rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  a {
    text-decoration: none;
    color: var(--muted);
  }
</style>
