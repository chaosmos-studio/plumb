---
import Icon from "./Icon.astro";

interface Props {
  /** The post's H2s, and any H3s under them, in page order. */
  headings: { depth: number; slug: string; text: string }[];
}
const items = Astro.props.headings;
// Headings keep their own words, numbers included, so the lists below are never numbered themselves.
---

<details class="toc-inline card" data-pagefind-ignore>
  <summary><span class="eyebrow">On this page</span></summary>
  <nav aria-label="On this page">
    <ul class="toc-list">
      {items.map(h => <li class={h.depth === 3 ? "sub" : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ul>
  </nav>
</details>

<aside class="toc-rail" data-pagefind-ignore>
  <nav class="toc-rail-nav" aria-label="On this page">
    <p class="eyebrow">On this page</p>
    <ul class="toc-list">
      {items.map(h => <li class={h.depth === 3 ? "sub" : undefined}><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>)}
    </ul>
  </nav>
</aside>

<button class="toc-pill" id="toc-pill" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="toc-sheet" data-pagefind-ignore>
  <Icon name="list" size={18} />
  <span class="visually-hidden">Contents: </span>
  <span class="toc-pill-label" data-toc-current>On this page</span>
</button>

<dialog class="toc-sheet" id="toc-sheet" aria-labelledby="toc-sheet-title" data-pagefind-ignore>
  <div class="toc-sheet-panel">
    <div class="toc-sheet-head">
      <p class="eyebrow" id="toc-sheet-title">On this page</p>
      <button class="toc-close" type="button" data-toc-close aria-label="Close contents"><Icon name="close" /></button>
    </div>
    <nav aria-label="On this page">
      <ul class="toc-list">
        {items.map(h => <li class={h.depth === 3 ? "sub" : undefined}><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>)}
      </ul>
    </nav>
  </div>
</dialog>

<script is:inline>
  (() => {
    const boot = () => {
      const root = document.documentElement;
      const pill = document.getElementById("toc-pill");
      const sheet = document.getElementById("toc-sheet");
      if (!pill || !sheet) return;
      const label = pill.querySelector("[data-toc-current]");
      const fallback = label.textContent;
      const links = [...document.querySelectorAll("[data-toc-link]")];
      const heads = [...new Set(links.map(a => a.getAttribute("href").slice(1)))]
        .map(id => document.getElementById(id))
        .filter(Boolean);

      const start = document.querySelector("[data-toc-start]");
      const end = document.querySelector("[data-toc-end]");
      const offset = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;

      // The section being read is the last one whose heading has passed the top 30% of the window. The
      // pill shows once the post's header has gone under the site header, and hides as the end of the
      // article comes up, so it never sits over the comments or the footer.
      let current;
      const update = () => {
        const line = innerHeight * 0.3 + 1;
        let active = null;
        for (const h of heads) {
          if (h.getBoundingClientRect().top > line) break;
          active = h;
        }
        const past = !start || start.getBoundingClientRect().bottom < offset;
        const before = !end || end.getBoundingClientRect().top > innerHeight;
        pill.classList.toggle("is-shown", past && before);
        if (active === current) return;
        current = active;
        const hash = active ? `#${active.id}` : "";
        for (const a of links) {
          if (a.getAttribute("href") === hash) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        }
        label.textContent = active ? active.textContent : fallback;
      };
      // Observers report only changes of intersection, so a long jump could carry a heading past the band
      // unseen. Watching every block of the post against the band means something always crosses it; the
      // second observer catches the header and the end of the article crossing the window's edges.
      const band = new IntersectionObserver(update, { rootMargin: "0px 0px -70% 0px" });
      for (const block of heads[0]?.parentElement?.children ?? []) band.observe(block);
      const edges = new IntersectionObserver(update, { rootMargin: `-${offset}px 0px 0px 0px` });
      if (start) edges.observe(start);
      if (end) edges.observe(end);

      // The page behind the sheet stays put; the stable gutter keeps a desktop scrollbar from shifting it.
      const lock = on => {
        root.style.overflow = on ? "hidden" : "";
        root.style.scrollbarGutter = on ? "stable" : "";
      };
      const open = () => {
        sheet.showModal();
        lock(true);
        pill.setAttribute("aria-expanded", "true");
        (sheet.querySelector('[aria-current="true"]') || sheet.querySelector("[data-toc-link]"))?.focus();
      };
      const close = () => {
        if (sheet.open) sheet.close();
      };
      sheet.addEventListener("close", () => {
        lock(false);
        pill.setAttribute("aria-expanded", "false");
        pill.focus({ preventScroll: true });
      });
      pill.addEventListener("click", open);
      sheet.addEventListener("click", e => {
        // A click on the dialog itself, not its panel, is a tap on the backdrop.
        if (e.target === sheet || e.target.closest("[data-toc-close]")) close();
        else if (e.target.closest("[data-toc-link]")) {
          // Unlock first, so the link's own jump to its section scrolls the page.
          lock(false);
          close();
        }
      });
      matchMedia("(min-width: 1100px)").addEventListener("change", e => e.matches && close());
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, { once: true });
    else boot();
  })();
</script>

<style>
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-list a {
    display: block;
    color: var(--muted);
    text-decoration: none;
  }
  .toc-list a:hover {
    color: var(--ink);
  }

  /* Without scripts, phones get the contents as a closed box above the text. */
  .toc-inline {
    margin: 0 0 2rem;
    padding: 0.2rem 1.4rem;
  }
  .toc-inline summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 0;
    cursor: pointer;
    list-style: none;
  }
  .toc-inline summary::-webkit-details-marker {
    display: none;
  }
  .toc-inline summary::after {
    content: "+";
    color: var(--accent);
    font-size: 1.4rem;
    line-height: 1;
  }
  .toc-inline[open] summary::after {
    content: "\2212";
  }
  .toc-inline .eyebrow {
    margin: 0;
  }
  .toc-inline .toc-list {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 1rem;
  }
  .toc-inline .sub {
    padding-left: 1rem;
  }
  :global(.js) .toc-inline {
    display: none;
  }

  .toc-rail,
  .toc-pill {
    display: none;
  }

  /* Wide screens: a rail beside the text, inside the page column. It works as plain links without
     scripts; with them, the section being read is marked. */
  @media (min-width: 1100px) {
    .toc-inline {
      display: none;
    }
    .toc-rail {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: var(--toc-rail);
    }
    .toc-rail-nav {
      position: sticky;
      top: var(--anchor-offset);
      max-height: calc(100vh - var(--anchor-offset) - 24px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-bottom: 0.5rem;
    }
    .toc-rail .eyebrow {
      margin-bottom: 0.8rem;
    }
    .toc-rail .toc-list {
      border-left: 1px solid var(--line);
    }
    .toc-rail .toc-list a {
      margin-left: -1px;
      padding: 0.32rem 0 0.32rem 1rem;
      border-left: 2px solid transparent;
      font-size: 0.92rem;
      line-height: 1.35;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .toc-rail .sub a {
      padding-left: 1.9rem;
      font-size: 0.86rem;
    }
    .toc-rail .toc-list a[aria-current="true"] {
      color: var(--ink);
      border-left-color: var(--accent);
    }
  }

  /* Phones and narrow windows: a pill that names the section being read and opens the sheet. */
  @media (max-width: 1099.98px) {
    :global(.js) .toc-pill {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      position: fixed;
      inset-inline: 0;
      bottom: calc(16px + env(safe-area-inset-bottom));
      z-index: 30;
      width: fit-content;
      max-width: min(100% - 32px, 420px);
      min-height: 44px;
      margin-inline: auto;
      padding: 0 1.15rem 0 0.95rem;
      border: 1px solid var(--line);
      border-radius: var(--pill);
      background: color-mix(in srgb, var(--surface) 90%, transparent);
      backdrop-filter: saturate(1.4) blur(12px);
      box-shadow: var(--shadow);
      color: var(--ink);
      font: 500 0.95rem/1.2 var(--font);
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
    }
    :global(.js) .toc-pill.is-shown {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
    }
  }
  .toc-pill :global(svg) {
    flex: none;
    color: var(--accent);
  }
  .toc-pill-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-sheet {
    position: fixed;
    inset: auto 0 0;
    width: min(100%, 560px);
    max-width: 100%;
    max-height: none;
    margin: 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }
  .toc-sheet::backdrop {
    background: rgba(0, 0, 0, 0.4);
    background: color-mix(in srgb, var(--ink, #000) 38%, transparent);
    backdrop-filter: blur(3px);
  }
  .toc-sheet-panel {
    display: flex;
    flex-direction: column;
    max-height: min(78vh, 640px);
    max-height: min(78dvh, 640px);
    padding: 0.9rem 0.9rem calc(1rem + env(safe-area-inset-bottom));
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    box-shadow: 0 -18px 40px -20px rgba(0, 0, 0, 0.35);
  }
  .toc-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 0.4rem 0.8rem;
  }
  .toc-sheet-head .eyebrow {
    margin: 0;
  }
  .toc-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--pill);
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .toc-sheet nav {
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .toc-sheet .toc-list {
    display: grid;
    gap: 2px;
  }
  .toc-sheet .toc-list a {
    padding: 0.7rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    line-height: 1.35;
  }
  .toc-sheet .sub a {
    padding-left: 1.8rem;
    font-size: 0.94rem;
  }
  .toc-sheet .toc-list a[aria-current="true"] {
    color: var(--ink);
    font-weight: 500;
    background: var(--accent-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    .toc-sheet[open] {
      animation: toc-rise 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .toc-sheet[open]::backdrop {
      animation: toc-fade 0.26s ease;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .toc-pill,
    :global(.js) .toc-pill.is-shown {
      transform: none;
    }
  }
  @keyframes toc-rise {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes toc-fade {
    from {
      opacity: 0;
    }
  }
</style>
