---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { href } from "../utils/url";
interface Props {
  post: CollectionEntry<"blog">;
  big?: boolean;
}
const { post, big = false } = Astro.props;
const date = post.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<article class:list={["post-card", "card", { big }]}>
  <a href={href(`blog/${post.id}/`)} class="cover-link" tabindex="-1" aria-hidden="true">
    <Image src={post.data.cover} alt={post.data.coverAlt} widths={[480, 800, 1200]} sizes={big ? "(min-width: 860px) 60vw, 100vw" : "(min-width: 860px) 33vw, 100vw"} class="cover" />
  </a>
  <div class="body">
    <p class="meta"><time datetime={post.data.pubDate.toISOString()}>{date}</time> · {post.data.tags[0]}</p>
    <h3><a href={href(`blog/${post.id}/`)}>{post.data.title}</a></h3>
    <p class="desc">{post.data.description}</p>
  </div>
</article>
<style>
  .post-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .body {
    padding: 1.1rem 1.3rem 1.4rem;
  }
  .meta {
    font-size: 0.85rem;
    color: var(--soft);
    margin: 0 0 0.4rem;
  }
  h3 {
    font-size: 1.22rem;
    margin: 0 0 0.5rem;
  }
  h3 a {
    text-decoration: none;
  }
  .desc {
    color: var(--muted);
    font-size: 0.98rem;
    margin: 0;
  }
  @media (min-width: 860px) {
    .big {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
    }
    .big .cover {
      height: 100%;
      aspect-ratio: auto;
    }
    .big .body {
      padding: 2rem;
      align-self: center;
    }
    .big h3 {
      font-size: 1.8rem;
    }
  }
</style>
