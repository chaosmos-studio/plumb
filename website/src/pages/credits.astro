---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Sponsor from "../components/Sponsor.astro";
import { credits, site, team } from "../site.config";
import { breadcrumbs } from "../utils/schema";

// Mirrors the game's CREDITS.md and credits.gd, plus what this website is built with.
const sections = [{ title: "Made by", items: team.map(p => ({ name: p.name, detail: p.role, href: p.url })) }, ...credits];
---
<Base
  title="Credits"
  description={`Everyone and everything behind ${site.name}: the two-person team, the Godot Engine, the type, and the tools this website is built with.`}
  path="credits/"
  schema={[breadcrumbs([{ label: "Credits", path: "credits/" }])]}
>
  <section class="narrow section" data-pagefind-body>
    <Crumbs trail={[{ label: "Credits" }]} />
    <p class="eyebrow">Credits</p>
    <h1>Thank <span class="accent">you</span></h1>
    <p class="lede">{site.name} stands on open-source work. Here is all of it, with the licences.</p>
    {sections.map(s => (
      <section class="block">
        <h2>{s.title}</h2>
        <ul class="list card">
          {s.items.map(i => (
            <li>
              <p class="name">{i.href ? <a href={i.href} rel="noopener">{i.name}</a> : i.name}</p>
              <p class="detail">{i.detail}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <div class="block">
      <Sponsor />
    </div>
  </section>
</Base>
<style>
  .block {
    margin-top: 2.5rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0.4rem 1.4rem;
  }
  .list li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .list li:last-child {
    border-bottom: 0;
  }
  .name {
    font-weight: 500;
    margin: 0;
  }
  .detail {
    color: var(--muted);
    margin: 0.2rem 0 0;
  }
</style>
