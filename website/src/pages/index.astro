---
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import FAQ from "../components/FAQ.astro";
import PostCard from "../components/PostCard.astro";
import Sponsor from "../components/Sponsor.astro";
import StoreButtons from "../components/StoreButtons.astro";
import Video from "../components/Video.astro";
import { faq, features, home, shots, site } from "../site.config";
import { faq as faqSchema, game, video } from "../utils/schema";
import { picture } from "../utils/images";
import { absoluteFromRoot, href } from "../utils/url";

const heroShot = picture(home.heroShot);
const heroAlt = shots.find(s => s.image === home.heroShot)?.alt ?? `${site.name} in play`;
const gallery = shots.map(s => ({ src: picture(s.image), alt: s.alt }));
const steps = home.how.steps.map(s => ({ ...s, src: picture(s.image) }));
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const screenshotUrls = await Promise.all(gallery.map(async s => absoluteFromRoot((await getImage({ src: s.src, width: 540, format: "png" })).src)));
const schema = [game(screenshotUrls), video("trailer")!, faqSchema(faq.slice(0, 4))];
---

<Base title={site.name} description={site.description} path="" schema={schema}>
  <section class="wrap hero" data-pagefind-body>
    <div class="copy">
      <p class="eyebrow">{home.eyebrow}</p>
      <h1>{home.title[0]}<span class="accent">{home.title[1]}</span></h1>
      <p class="lede">{home.lede}</p>
      <StoreButtons />
      <ul class="facts">
        {home.facts.map(f => <li>{f}</li>)}
      </ul>
    </div>
    <div class="phone">
      <Image src={heroShot} alt={heroAlt} widths={[320, 480, 640]} sizes="(min-width: 860px) 360px, 70vw" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">{home.watch.eyebrow}</p>
      <h2>{home.watch.title}</h2>
      <p class="lede">{home.watch.lede}</p>
    </div>
    <Video id="trailer" />
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">How to play</p>
      <h2>{home.how.title}</h2>
    </div>
    <div class="grid grid-3">
      {steps.map((s, i) => (
        <article class="step card">
          <Image src={s.src} alt={`Step ${i + 1} of a ${site.name} level: ${s.title.toLowerCase()}`} widths={[320, 480]} sizes="(min-width: 720px) 33vw, 100vw" />
          <div class="step-body">
            <p class="num">{i + 1}</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="more"><a href={href(home.how.link.href)}>{home.how.link.label}</a></p>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">Why it's good</p>
      <h2>{home.featuresTitle}</h2>
    </div>
    <div class="grid grid-3">
      {features.map(f => (
        <article class="feature card">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section gallery-section" data-reveal>
    <div class="wrap section-head">
      <p class="eyebrow">Screenshots</p>
      <h2>See it on a phone</h2>
    </div>
    <div class="gallery" role="list">
      {gallery.map(s => (
        <figure role="listitem">
          <Image src={s.src} alt={s.alt} widths={[240, 360, 480]} sizes="280px" />
          <figcaption>{s.alt}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">From the blog</p>
      <h2>Tips and stories</h2>
    </div>
    <div class="grid grid-3">
      {posts.map(p => <PostCard post={p} />)}
    </div>
    <p class="more"><a href={href("blog/")}>All posts</a></p>
  </section>

  <section class="wrap sponsor-section" data-reveal>
    <Sponsor />
  </section>

  <section class="narrow section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">Questions</p>
      <h2>Frequently asked</h2>
    </div>
    <FAQ items={faq.slice(0, 4)} />
    <p class="more"><a href={href("support/")}>More answers and support</a></p>
  </section>

  <section class="wrap section" data-reveal>
    <div class="final card">
      <h2>{home.final.title}</h2>
      <p class="lede">{home.final.lede}</p>
      <StoreButtons />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(32px, 7vw, 80px);
  }
  @media (min-width: 860px) {
    .hero {
      grid-template-columns: 1.25fr 1fr;
    }
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 0;
  }
  .facts li {
    padding: 0.25rem 0.8rem;
    border-radius: var(--pill);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .phone {
    justify-self: center;
    width: min(360px, 78vw);
    transform: rotate(3deg);
  }
  .step {
    overflow: hidden;
  }
  .step img {
    width: 100%;
    background: var(--surface-2);
  }
  .step-body {
    padding: 1.1rem 1.3rem 1.3rem;
  }
  .num {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    margin: 0 0 0.6rem;
  }
  .step p:last-child,
  .feature p {
    color: var(--muted);
    margin: 0;
  }
  .feature {
    padding: 1.4rem 1.5rem;
  }
  .more {
    margin-top: 1.4rem;
  }
  .more a {
    font-weight: 500;
  }
  .gallery {
    display: flex;
    gap: 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem var(--gutter) 1.5rem;
  }
  .gallery figure {
    flex: 0 0 auto;
    width: 250px;
    margin: 0;
    scroll-snap-align: center;
  }
  .gallery figcaption {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }
  .sponsor-section {
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .final {
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    display: grid;
    justify-items: center;
    background: linear-gradient(135deg, var(--surface), var(--surface-2));
  }
</style>
