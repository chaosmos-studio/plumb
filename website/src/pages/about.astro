---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Person from "../components/Person.astro";
import Sponsor from "../components/Sponsor.astro";
import StoreButtons from "../components/StoreButtons.astro";
import { about, builtWith, site, team } from "../site.config";
import { breadcrumbs, game, person } from "../utils/schema";
import { absolute, href } from "../utils/url";

const schema = [
  breadcrumbs([{ label: "About", path: "about/" }]),
  { "@context": "https://schema.org", "@type": "AboutPage", name: `About ${site.name}`, url: absolute("about/"), about: game(), author: team.map(person) },
];
---
<Base title={about.title} description={about.description} path="about/" schema={schema}>
  <section class="narrow section" data-pagefind-body>
    <Crumbs trail={[{ label: "About" }]} />
    <p class="eyebrow">About</p>
    <h1>{about.heading[0]}<span class="accent">{about.heading[1]}</span></h1>
    <p class="lede">{about.lede}</p>
    <div class="prose">
      {about.sections.map(sec => (
        <>
          <h2>{sec.heading}</h2>
          {sec.paragraphs.map(p => <p>{p}</p>)}
        </>
      ))}
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">Team</p>
      <h2>Made by two</h2>
      <p class="lede">{site.name} is made by a two-person team: one person, and one AI model.</p>
    </div>
    <div class="grid grid-2">
      {team.map(p => <Person person={p} />)}
    </div>
    <p class="note">{about.teamNote}</p>
    <div class="sponsor">
      <Sponsor />
    </div>
  </section>

  <section class="narrow section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">Fact sheet</p>
      <h2>{site.name} at a glance</h2>
    </div>
    <table class="facts card">
      <tbody>
        {about.facts.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
        <tr><th>Contact</th><td><a href={`mailto:${site.email}`}>{site.email}</a></td></tr>
      </tbody>
    </table>
    <div class="chips">
      {builtWith.map(b => <span class="chip">{b}</span>)}
    </div>
    <p class="more">The fonts, tools and everything else {site.name} uses are listed on the <a href={href("credits/")}>credits page</a>.</p>
    <StoreButtons />
  </section>
</Base>
<style>
  .note {
    color: var(--muted);
    margin-top: 1.4rem;
    max-width: 48rem;
  }
  .sponsor {
    margin-top: 2.5rem;
  }
  .facts {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
  }
  .facts th,
  .facts td {
    text-align: left;
    padding: 0.85rem 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .facts tr:last-child th,
  .facts tr:last-child td {
    border-bottom: 0;
  }
  .facts td {
    overflow-wrap: anywhere;
  }
  .facts th {
    width: 34%;
    font-weight: 500;
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.4rem 0;
  }
  .more {
    margin-bottom: 1.4rem;
  }
</style>
