---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Person from "../components/Person.astro";
import StoreButtons from "../components/StoreButtons.astro";
import { builtWith, site, team } from "../site.config";
import { breadcrumbs, game, person } from "../utils/schema";
import { absolute, href } from "../utils/url";

const schema = [
  breadcrumbs([{ label: "About", path: "about/" }]),
  { "@context": "https://schema.org", "@type": "AboutPage", name: `About ${site.name}`, url: absolute("about/"), about: game(), author: team.map(person) },
];
---
<Base
  title="About Plumb and the team behind it"
  description="Plumb is a calm marble puzzle made by a two-person team: Shravan Goswami, and Claude Opus 5.5, an AI model by Anthropic. How the game was made and why."
  path="about/"
  schema={schema}
>
  <section class="narrow section" data-pagefind-body>
    <Crumbs trail={[{ label: "About" }]} />
    <p class="eyebrow">About</p>
    <h1>A small game about <span class="accent">gravity</span></h1>
    <p class="lede">Plumb is a calm logic puzzle. You tilt a board, every marble rolls at once, and each one has to find the hole of its own colour. It is free, it plays offline, and it has no ads, no timers and no lives.</p>

    <div class="prose">
      <h2>Why we made it</h2>
      <p>Most puzzle games ask you to move one thing at a time. Plumb moves everything at once. That one twist turns four swipe directions into a surprisingly deep game: every tilt is a small chain of consequences, and the fun is in reading the board before you make it.</p>
      <p>We wanted a game that respects your time and attention. No energy bars, no countdowns, no ads between levels. Just a board, some marbles, and a moment of "oh, that's how."</p>

      <h2>How it is built</h2>
      <p>Every level is generated by a program and then proven solvable by another program, a solver that tries every possible sequence of tilts and records the shortest one. That shortest route is the level's par, and it is how the stars are scored. The levels are ordered so that each one is at least as hard as the one before, and no two levels are near-copies of each other, even turned or mirrored. The tests check all of that again on every build.</p>
      <p>The art, the sounds and the music are made in code, not bought or downloaded. The game is written in GDScript with the Godot Engine, and the same code runs on Android and in your browser.</p>
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">Team</p>
      <h2>Made by two</h2>
      <p class="lede">Plumb is made by a two-person team: one person, and one AI model.</p>
    </div>
    <div class="grid grid-2">
      {team.map(p => <Person person={p} />)}
    </div>
    <p class="note">Shravan decides what the game is, plays every build and has the final say. Claude writes most of the code, the level generator and solver, the art and sound pipelines and this website, in conversation with Shravan in Claude Code.</p>
  </section>

  <section class="narrow section" data-reveal>
    <div class="section-head">
      <p class="eyebrow">Fact sheet</p>
      <h2>Plumb at a glance</h2>
    </div>
    <table class="facts card">
      <tbody>
        <tr><th>Developer</th><td>Shravan Goswami, with Claude Opus 5.5</td></tr>
        <tr><th>Genre</th><td>Logic puzzle</td></tr>
        <tr><th>Platforms</th><td>Android (Google Play), web browser</td></tr>
        <tr><th>Price</th><td>Free, no ads, no in-app purchases</td></tr>
        <tr><th>Engine</th><td>Godot Engine</td></tr>
        <tr><th>Contact</th><td><a href={`mailto:${site.email}`}>{site.email}</a></td></tr>
      </tbody>
    </table>
    <div class="chips">
      {builtWith.map(b => <span class="chip">{b}</span>)}
    </div>
    <p class="more">The fonts, tools and everything else Plumb uses are listed on the <a href={href("credits/")}>credits page</a>.</p>
    <StoreButtons />
  </section>
</Base>
<style>
  .note {
    color: var(--muted);
    margin-top: 1.4rem;
    max-width: 48rem;
  }
  .facts {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
  }
  .facts th,
  .facts td {
    text-align: left;
    padding: 0.85rem 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .facts tr:last-child th,
  .facts tr:last-child td {
    border-bottom: 0;
  }
  .facts th {
    width: 34%;
    font-weight: 500;
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.4rem 0;
  }
  .more {
    margin-bottom: 1.4rem;
  }
</style>
