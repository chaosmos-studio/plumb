---
import Base from "../layouts/Base.astro";
import StoreButtons from "../components/StoreButtons.astro";
import { href } from "../utils/url";
---
<Base title="Page not found" description="This page rolled away. Head back to the Plumb home page, the blog or support." path="404/" noindex>
  <section class="narrow section center">
    <p class="eyebrow">404</p>
    <h1>This page rolled <span class="accent">away</span></h1>
    <p class="lede">The link may be old, or the page moved. Try the <a href={href("")}>home page</a>, the <a href={href("blog/")}>blog</a> or <a href={href("support/")}>support</a>.</p>
    <StoreButtons />
  </section>
</Base>
<style>
  .center {
    text-align: center;
    display: grid;
    justify-items: center;
  }
</style>
