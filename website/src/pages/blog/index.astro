---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import PostCard from "../../components/PostCard.astro";
import { blogPage, site } from "../../site.config";
import { breadcrumbs } from "../../utils/schema";
import { absolute, href } from "../../utils/url";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find(p => p.data.featured) ?? posts[0];
const rest = posts.filter(p => p !== featured);
const tags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
const schema = [
  breadcrumbs([{ label: "Blog", path: "blog/" }]),
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: `The ${site.name} blog`,
    url: absolute("blog/"),
    blogPost: posts.map(p => ({ "@type": "BlogPosting", headline: p.data.title, url: absolute(`blog/${p.id}/`), datePublished: p.data.pubDate.toISOString() })),
  },
];
---
<Base
  title={blogPage.title}
  description={blogPage.description}
  path="blog/"
  schema={schema}
>
  <section class="wrap section top">
    <Crumbs trail={[{ label: "Blog" }]} />
    <p class="eyebrow">The {site.name} blog</p>
    <h1>{blogPage.heading[0]}<span class="accent">{blogPage.heading[1]}</span></h1>
    <p class="lede">{blogPage.lede}</p>
    <div class="tags">
      {tags.map(t => <a class="chip" href={href(`blog/tags/${t.toLowerCase().replace(/\s+/g, "-")}/`)}>{t}</a>)}
    </div>
  </section>
  <section class="wrap">
    {featured && <PostCard post={featured} big />}
    <div class="grid grid-3 list">
      {rest.map(p => <PostCard post={p} />)}
    </div>
  </section>
</Base>
<style>
  .top {
    padding-bottom: 2rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }
  .list {
    margin-top: 1.4rem;
  }
</style>
